{
  "name": "Pagamento",
  "type": "object",
  "properties": {
    "contratoId": {
      "type": "string",
      "title": "ID do contrato"
    },
    "nf": {
      "type": "string",
      "title": "N\u00famero da nota fiscal"
    },
    "dataNF": {
      "type": "string",
      "title": "Emiss\u00e3o da nota",
      "format": "date"
    },
    "valorNF": {
      "type": "number",
      "title": "Valor da nota",
      "default": 0
    },
    "valorPago": {
      "type": "number",
      "title": "Valor pago",
      "default": 0
    },
    "dataPagamento": {
      "type": "string",
      "title": "Data do pagamento",
      "format": "date"
    },
    "motivo": {
      "type": "string",
      "title": "Motivo da reten\u00e7\u00e3o"
    },
    "situacao": {
      "type": "string",
      "title": "Situa\u00e7\u00e3o",
      "enum": [
        "Pago",
        "Pendente",
        "Retido",
        "Cancelado"
      ],
      "default": "Pendente"
    }
  },
  "required": [
    "contratoId",
    "nf",
    "valorNF"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}