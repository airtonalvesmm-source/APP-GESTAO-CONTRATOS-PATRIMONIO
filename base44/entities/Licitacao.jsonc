{
  "name": "Licitacao",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "title": "N\u00famero"
    },
    "ano": {
      "type": "string",
      "title": "Ano"
    },
    "modalidade": {
      "type": "string",
      "title": "Modalidade"
    },
    "processo": {
      "type": "string",
      "title": "Processo"
    },
    "categoria": {
      "type": "string",
      "title": "Categoria",
      "enum": [
        "Mobili\u00e1rio",
        "Seguran\u00e7a",
        "Climatiza\u00e7\u00e3o",
        "Eletroeletr\u00f4nicos e Utilidades"
      ]
    },
    "srp": {
      "type": "string",
      "title": "Registro de pre\u00e7os",
      "enum": [
        "Sim",
        "N\u00e3o"
      ],
      "default": "Sim"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Em planejamento",
        "Publicado",
        "Em disputa",
        "Em julgamento",
        "Homologado",
        "Fracassado",
        "Deserto",
        "Revogado",
        "Anulado"
      ],
      "default": "Em planejamento"
    },
    "qtdItens": {
      "type": "number",
      "title": "Quantidade de itens",
      "default": 0
    },
    "valorGlobal": {
      "type": "number",
      "title": "Valor global",
      "default": 0
    }
  },
  "required": [
    "numero",
    "ano",
    "modalidade"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}