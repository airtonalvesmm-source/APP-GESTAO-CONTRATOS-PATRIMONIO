        "type": "string"
      }
    },
    "dataConfirmacaoOrdem": {
      "type": "string",
      "title": "Data da confirma\u00e7\u00e3o do recebimento da ordem de fornecimento",
      "format": "date"
    },
    "dataLimiteEntrega": {
      "type": "string",
      "title": "Data limite para entrega",
      "format": "date"
    },
    "dataRecebimentoProvisorio": {
      "type": "string",
      "title": "Data do recebimento provis\u00f3rio",
      "format": "date"
    },
    "dataRecebimentoDefinitivo": {
      "type": "string",
      "title": "Data do recebimento definitivo",
      "format": "date"
    },
    "observacoes": {
      "type": "string",
      "title": "Anota\u00e7\u00f5es complementares"
    }
  },
  "required": [
