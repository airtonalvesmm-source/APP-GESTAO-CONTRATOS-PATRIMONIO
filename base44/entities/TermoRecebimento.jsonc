{
  "name": "TermoRecebimento",
  "type": "object",
  "properties": {
    "contratoId": {
      "type": "string",
      "title": "ID do contrato"
    },
    "numero": {
      "type": "string",
      "title": "N\u00famero do termo"
    },
    "pagamentoIds": {
      "type": "array",
      "title": "IDs das notas fiscais",
