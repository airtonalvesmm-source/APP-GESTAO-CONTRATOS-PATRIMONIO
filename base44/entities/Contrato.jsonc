{
  "name": "Contrato",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "title": "Tipo",
      "enum": [
        "Contrato",
        "Nota de empenho"
      ],
      "default": "Contrato"
    },
    "numero": {
      "type": "string",
      "title": "N\u00famero"
    },
    "processo": {
      "type": "string",
      "title": "Processo"
    },
    "notaEmpenho": {
      "type": "string",
      "title": "Nota de empenho"
    },
    "ataId": {
      "type": "string",
      "title": "ID da ata vinculada"
    },
    "fornecedorId": {
      "type": "string",
      "title": "ID do fornecedor"
    },
    "fornecedor": {
      "type": "string",
      "title": "Nome do fornecedor"
    },
    "cnpj": {
      "type": "string",
      "title": "CNPJ"
    },
    "objeto": {
      "type": "string",
      "title": "Objeto"
    },
    "situacao": {
      "type": "string",
      "title": "Situa\u00e7\u00e3o",
      "enum": [
        "Vigente",
        "Encerrado",
        "Rescindido",
        "Suspenso",
        "Cancelado"
      ],
      "default": "Vigente"
    },
    "statusEntrega": {
      "type": "string",
      "title": "Status de entrega",
      "enum": [
        "Aguardando entrega",
        "Entregue"
      ],
      "default": "Aguardando entrega"
    },
    "inicio": {
      "type": "string",
      "title": "In\u00edcio da vig\u00eancia",
      "format": "date"
    },
    "fim": {
      "type": "string",
      "title": "Fim da vig\u00eancia",
      "format": "date"
    },
    "fiscalNome": {
      "type": "string",
      "title": "Fiscal do contrato"
    },
    "portariaFiscalizacao": {
      "type": "string",
      "title": "Portaria de fiscaliza\u00e7\u00e3o"
    },
    "pgeaFiscalizacao": {
      "type": "string",
      "title": "PGEA de fiscaliza\u00e7\u00e3o"
    },
    "itens": {
      "type": "array",
      "title": "Itens contratados",
      "items": {
        "type": "object",
        "properties": {
          "itemAtaId": {
            "type": "string"
          },
          "benId": {
            "type": "string"
          },
          "qtd": {
            "type": "number"
          },
          "valor": {
            "type": "number"
          },
          "pcaId": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "numero"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}